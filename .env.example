# Copie para .env (o .env nunca vai para o Git). Na Hostinger, cadastre as mesmas
# variáveis no painel do app Node.js.

# URL pública do site (canonical, Open Graph, sitemap e RSS). Usada no build.
VITE_SITE_URL=https://criasite.app

# MySQL. Sem DB_NAME/DB_USER o site usa os dados de exemplo (mock-data.ts).
# Na Hostinger: host 127.0.0.1 (nunca o srvNNNN.hstgr.io).
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

# Protege /api/cron/* (Cron Job da Hostinger). Mínimo de 24 caracteres aleatórios.
CRON_TOKEN=

# Robô de notícias (Google AI Studio, plano gratuito). Sem ela, o robô só registra "sem chave".
GEMINI_API_KEY=

# Painel /admin (npm run admin:hash gera o hash e o segredo).
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
SESSION_SECRET=

# Pasta das imagens das notícias (padrão: ~/criasite-media, fora da pasta do app).
# MEDIA_DIR=

# Opcional: ca-pub-… do AdSense; liga anúncios, ads.txt e banner de cookies.
# ADSENSE_CLIENT=
# Google Analytics 4 (ID público G-...). Sem ele, o GA fica desligado. Lido em tempo de execução.
GA_MEASUREMENT_ID=G-MZJX2TZ404
